# Banc de charge Locksy : variables lues par docker compose (bench/.env) et
# par les scripts de bench/scripts/. Copier ce fichier en bench/.env pour le
# modifier ; sans bench/.env, les valeurs ci-dessous sont les valeurs par défaut.

# Image du serveur à mesurer. bench-up.sh la construit depuis le Dockerfile du
# dépôt si elle est absente (ou avec --rebuild).
LOCKSY_IMAGE=locksy-bench:local

# Profil matériel du serveur (limites de deploiement/docker-compose.onprem.yml) :
# - REF-PROD : 512m (seuils bloquants, ce qui est livré) ;
# - REF-1G   : 1g   (dimensionnement, si REF-PROD échoue sur les gros jeux).
# bench-up.sh --profile REF-PROD|REF-1G fixe cette valeur.
LOCKSY_MEM=512m

# Réseau interne du banc. À changer si ce sous-réseau chevauche un réseau
# existant (preflight.sh le vérifie) ; l'adresse du serveur doit en faire partie.
BENCH_SUBNET=172.30.0.0/24
BENCH_SERVER_IP=172.30.0.10

# Cœurs réservés : le serveur et l'injecteur (k6, Playwright) ne partagent
# jamais un cœur. preflight.sh refuse deux ensembles qui se chevauchent.
SERVER_CPUSET=0,1
INJECTOR_CPUSET=4-7

# Jeton d'installation du premier compte (valeur de TEST, au moins 20 caractères).
LOCKSY_SETUP_TOKEN=banc-jeton-installation-0123456789

# production (défaut) ou test (expose /api/test/counters).
LOCKSY_ENV=production
