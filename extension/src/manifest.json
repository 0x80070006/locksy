{
  "manifest_version": 3,
  "name": "Locksy",
  "short_name": "Locksy",
  "version": "1.0.0",
  "description": "Remplit vos identifiants depuis votre coffre Locksy. Tout est chiffré et déchiffré sur ce poste.",
  "action": {
    "default_title": "Locksy",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite", "identity"],
  "optional_host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"],
  "minimum_chrome_version": "116",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'"
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+L" }, "description": "Ouvrir Locksy" }
  }
}
